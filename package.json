{
  "name": "neo-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint ui && ng lint playground",
    "prepare": "husky",
    "storybook": "ng run ui:storybook",
    "build-storybook": "ng run ui:build-storybook"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2201.0",
    "@angular-devkit/build-angular": "^22.1.0",
    "@angular-devkit/core": "^22.1.0",
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@compodoc/compodoc": "latest",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-onboarding": "^10.5.7",
    "@storybook/angular": "^10.5.7",
    "@types/node": "^20",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.5.7",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.3.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "sass": "^1.102.0",
    "storybook": "^10.5.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.html": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  }
}
